{
  "name": "lexiconic",
  "version": "0.1.0",
  "description": "Privacy-first, locally hosted spell and grammar checking Chrome extension powered by Ollama",
  "private": true,
  "scripts": {
    "build":   "node scripts/build.js",
    "pack":    "node scripts/build.js && node scripts/pack.js",
    "clean":   "node -e \"const fs=require('fs');if(fs.existsSync('dist'))fs.rmSync('dist',{recursive:true,force:true});console.log('Cleaned dist/');\"",
    "validate": "node scripts/validate.js"
  },
  "devDependencies": {
    "archiver": "^7.0.1"
  }
}
